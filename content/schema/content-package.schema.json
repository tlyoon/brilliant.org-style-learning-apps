{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/content-package.schema.json",
  "title": "Learning content package",
  "type": "object",
  "required": ["schemaVersion", "packageId", "chapter", "subchapter", "status", "locales", "learningObjectives", "sourceManifest", "activities"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "packageId": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "chapter": {"type": "string", "minLength": 1},
    "subchapter": {"type": "string", "minLength": 1},
    "status": {"enum": ["draft", "review", "publishable"]},
    "locales": {"type": "array", "minItems": 3, "uniqueItems": true, "contains": {"const": "en"}, "items": {"enum": ["en", "ms", "zh"]}},
    "learningObjectives": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "sourceManifest": {"type": "string", "minLength": 1},
    "activities": {
      "type": "array",
      "items": {"$ref": "#/$defs/activity"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "localized": {
      "type": "object",
      "required": ["en", "ms", "zh"],
      "properties": {"en": {"type": "string", "minLength": 1}, "ms": {"type": "string", "minLength": 1}, "zh": {"type": "string", "minLength": 1}},
      "additionalProperties": false
    },
    "option": {
      "type": "object",
      "required": ["id", "label"],
      "properties": {
        "id": {"type": "string", "pattern": "^(?=.*\\S).+$"},
        "label": {"$ref": "#/$defs/localized"}
      },
      "additionalProperties": false
    },
    "answerKey": {
      "type": "object",
      "required": ["correct", "options"],
      "properties": {
        "correct": {"type": "string", "pattern": "^(?=.*\\S).+$"},
        "options": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/option"}
        }
      },
      "additionalProperties": false
    },
    "activity": {
      "type": "object",
      "required": ["id", "type", "difficulty", "calculatorFree", "numericAnswerRequired", "objective", "prompt", "answerKey", "hints", "feedback", "provenance"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "type": {"enum": ["mcq", "interactive"]},
        "difficulty": {"enum": ["easy", "moderate", "challenging"]},
        "calculatorFree": {"const": true},
        "numericAnswerRequired": {"const": false},
        "objective": {"type": "string", "minLength": 1},
        "prompt": {"$ref": "#/$defs/localized"},
        "answerKey": {"$ref": "#/$defs/answerKey"},
        "hints": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/localized"}},
        "feedback": {"$ref": "#/$defs/localized"},
        "misconceptions": {"type": "array", "items": {"type": "string"}},
        "accessibilityText": {"$ref": "#/$defs/localized"},
        "provenance": {"type": "object", "required": ["sourceLocation", "originalContent"], "properties": {"sourceLocation": {"type": "string", "minLength": 1}, "originalContent": {"const": true}}, "additionalProperties": false}
      },
      "additionalProperties": false
    }
  }
}

